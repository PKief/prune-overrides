{
  "name": "prune-overrides",
  "version": "0.3.0",
  "description": "CLI tool that analyzes npm overrides entries and determines whether they are still required or can be safely removed",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "prune-overrides": "./dist/bin/prune-overrides.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "start": "node dist/bin/prune-overrides.js",
    "test": "node --import ./scripts/loader.js --test src/**/*.test.ts",
    "test:coverage": "node --import ./scripts/loader.js --test --experimental-test-coverage src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "npm",
    "overrides",
    "dependencies",
    "cleanup",
    "prune",
    "cli"
  ],
  "author": "Philipp Kief",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PKief/prune-overrides.git"
  },
  "bugs": {
    "url": "https://github.com/PKief/prune-overrides/issues"
  },
  "homepage": "https://github.com/PKief/prune-overrides#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "changelog-machine": "^2.1.0",
    "typescript": "^7.0.2"
  }
}
